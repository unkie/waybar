{
	"output": "HDMI-A-1",
	"layer": "top",
	"exclusive": true,
	"position": "top",
	"height": 0,
	"margin-left": 0,
	"margin-right": 0,
	"margin-top": 0,
	"margin-bottom": 0,
	"spacing": 0,
	"reload_style_on_change": true,

	"modules-left": [
		"custom/spacer",
		"pulseaudio",
		"custom/separator",
		"custom/media"
	],
	"modules-center": [
		"hyprland/workspaces"
	],
	"modules-right": [
		"tray",
		"custom/separator",
		"custom/kbdlayout",
		"custom/separator",
		"clock#time",
		"clock#date",
		"custom/spacer"
	],

	"hyprland/workspaces": {
		"format": "{name}: <span font_size='120%'>{windows}</span> ",
		//"format-muted": " <span font_size='210%' font_variant='smallcaps'>muted</span>",
		"format-icons": {
			"default": "",
			"urgent": "",
			"active": ""
		},
		"window-rewrite": {
			"title<.*youtube.*>": "",
			"class<steam>": "󰓓",
			"class<exaile>": "󰝚",
			"class<gimp.*>": "",
			"class<firefox>": "",
			"class<(firefox|chromium)> title<.*[gG]it[hH]ub.*>": "",
			"class<firefox> title<.*Private Browsing>": "",
			"class<chromium>": "",
			"class<chromium> initialTitle<.*Incognito.*>": "",
			"class<gucharmap>": "á",
			"class<mpv>": "󰎁",
			"class<org.gnome.Calculator>": "",
			"class<kitty>": "",
			"class<logseq>": "󱃲",
			"class<.*godotengine.*>": "",
			"class<l[e3]afpad>": "",
			"class<(xpdf|com.github.xournalpp.xournalpp)>": "",
			"class<blender>": "",
			"title<Windows>": "",
		},
		"window-rewrite-default": "",
		"format-window-separator": " ",
		"show-special": false,
		"special-visible-only": false,
		"all-outputs": false,
		"active-only": false,
		"move-to-monitor": false,
		"ignore-workspaces": [],
		"sort-by": "number",
		"persistent-only": true,
		"persistent-workspaces": { "*": [1,2,3,4,5,6] },
		"disable-scroll": true,
		"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
	},
	"clock#time": {
		"interval": 60,
		"format": " {:%H:%M}",
		"timezone": "Europe/Vienna",
		//"timezones": ...,
		//"locale": ...,
		//"max-length": ...,
		"rotate": 0,
		//"on-click": "~/scripts/date.sh",
		//"on-scroll-up": "...",
		//"on-scroll-down": "...",
		//"smooth-scrolling-threshold": ...,
		"tooltip": false,
		//"tooltip-format": "..."
	},
	"clock#date": {
		"interval": 60,
		"format": "󰃭 {:%Y-%m-%d}",
		"timezone": "Europe/Vienna",
		//"timezones": ...,
		//"locale": ...,
		//"max-length": ...,
		"rotate": 0,
		//"on-click": "orage",
		//"on-scroll-up": "...",
		//"on-scroll-down": "...",
		//"smooth-scrolling-threshold": ...,
		"tooltip": false,
		//"tooltip-format": "..."
	},
	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"scroll-step": 4,
		"format-muted": " <span font_size='110%' font_variant='smallcaps'>muted</span>",
		"format-source": "",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
		"on-click": "pactl set-sink-mute 0 toggle",
		"on-click-right": "pavucontrol"

	},
	"custom/media": {
		"format": "{}",
		"interval": 1,
		"exec": "$HOME/.config/waybar/get_media.sh",
		"on-click": "playerctl -p exaile play-pause"
	},
	"custom/kbdlayout": {
		"format": "  {}",
		"interval": 1,
		"exec": "$HOME/.config/waybar/get_kbdlayout.sh",
		//"on-click": "...",
	},
	"tray": {
		"icon-size": 18,
		"show-passive-items": false,
		//"smooth-scrolling-threshold": ...,
		"spacing": 10,
		"reverse-direction": false,
	},
	"network#lan": {
		"interval": 10,
		"format-ethernet": "󰌘 {ipaddr}",
		"format-linked": "󰌚 {ifname} (No IP)",
		"format-disconnected": "󰌙 Disconnected",
		"format-alt": " {bandwidthDownBytes}  {bandwidthUpBytes}",
		"tooltip-format": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\nNetmask: {netmask}"
	},
	"network#wifi": {
		"interval": 10,
		"format-wifi": " {ipaddr}",
		"format-disconnected": "󰖪 {ifname (No IP)}",
		"tooltip-format": "Network: {essid}\nSignal strength: {signaldBm}dBm ({signalStrength}%)\nFrequency: {frequency}MHz\nInterface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\nNetmask: {netmask}"
	},
	"battery": {
		"interval": 60,
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 20
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{time} {icon}",
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
	},
	"memory": {
		"interval": 5,
		"states": {
			"c": 90, // critical
			"h": 60, // high
			"m": 30, // medium
		},
		"format": "󰾆 {percentage}%",
		"format-m": "󰾅 {percentage}%",
		"format-h": "󰓅 {percentage}%",
		"format-c": " {percentage}%",
		"format-alt": "󰾆 {used} GiB",
		"tooltip": true,
		"tooltip-format": "󰾆 {percentage}%\n {used:0.1f} GiB / {total:0.1f} GiB\n {swapUsed:0.1f} GiB / {swapAvail:0.1f} GiB"
	},
	"cpu": {
		"interval": 10,
		"format": "󰍛 {usage}%"
	},
	"disk": {
		"interval": 5,
		"format": "󰋊 {percentage_used:}%",
		"paths": ["/"]
	},
	"custom/end-left": {
		"format": " ",
		"interval" : "once",
		"tooltip": false
	},
	"custom/end-right": {
		"format": " ",
		"interval" : "once",
		"tooltip": false
	},
	"custom/spacer": {
		"format": "  ",
		"interval" : "once",
		"tooltip": false
	},
	"custom/separator": {
		"format": "<span weight='light'>⎟</span>",
		"interval" : "once",
		"tooltip": false
	}
}

// vim: set filetype=json
